{
  "version": 2,
  "builds": [
    {
      "src": "api/audit.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/audit",
      "dest": "/api/audit.py"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ],
  "functions": {
    "api/audit.py": {
      "maxDuration": 30
    }
  }
}
