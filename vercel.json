{
  "version": 2,
  "builds": [
    {
      "src": "api/audit.py",
      "use": "@vercel/python"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/audit",
      "dest": "/api/audit.py"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "api/audit.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
